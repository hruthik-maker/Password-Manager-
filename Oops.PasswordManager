#include <iostream>
#include <fstream>
#include <string>
using namespace std;
class PasswordManager
{
private:
    string website, username, password;
public:
    // Function to add password
    void addPassword()
    {
        ofstream file("passwords.txt", ios::app);
        if (!file)
        {
            cout << "Error opening file!" << endl;
            return;
        }
        cout << "Enter Website: ";
        cin >> website;
        cout << "Enter Username: ";
        cin >> username;
        cout << "Enter Password: ";
        cin >> password;
        file << website << " "
             << username << " "
             << password << endl;
        file.close();
        cout << "Password Saved Successfully!" << endl;
    }
    // Function to view passwords
    void viewPasswords()
    {
        ifstream file("passwords.txt");
        if (!file)
        {
            cout << "No records found!" << endl;
            return;
        }
        cout << "\n--- Saved Passwords ---\n";
        while (file >> website >> username >> password)
        {
        }
            cout << "Website: " << website << endl;
            cout << "Username: " << username << endl;
            cout << "Password: " << password << endl;
            cout << "-----------------------" << endl;
        file.close();
    }
    // Function to search password
    void searchPassword()
    {
        ifstream file("passwords.txt");
        string search;
        bool found = false;
        cout << "Enter Website to Search: ";
        cin >> search;
        while (file >> website >> username >> password)
        {
            if (website == search)
            {
                cout << "\nRecord Found!" << endl;
                cout << "Website: " << website << endl;
                cout << "Username: " << username << endl;
                cout << "Password: " << password << endl;
                found = true;
            }
        }
        if (!found)
        {
            cout << "Record Not Found!" << endl;
        }
        file.close();
    }
    // Function to delete all passwords
    void deletePasswords()
    {
        ofstream file("passwords.txt", ios::trunc);
        if (!file)
        {
            cout << "Unable to delete records!" << endl;
            return;
        }
        file.close();
        cout << "All Password Records Deleted!" << endl;
    }
};
int main()
{
    PasswordManager pm;
    int choice;
    do
    {
        cout << "\n===== PASSWORD MANAGER =====" << endl;
        cout << "1. Add Password" << endl;
        cout << "2. View Passwords" << endl;
        cout << "3. Search Password" << endl;
        cout << "4. Delete All Passwords" << endl;
        cout << "5. Exit" << endl;
        cout << "\nEnter Your Choice: ";
        cin >> choice;
        switch (choice)
        {
        case 1:
                pm.addPassword();
                break;
            case 2:
                pm.viewPasswords();
                break;
            case 3:
                pm.searchPassword();
                break;
            case 4:
                pm.deletePasswords();
                break;
            case 5:
                cout << "Thank You for Using "
                     << "Password Manager!" << endl;
                break;
            default:
                cout << "Invalid Choice!" << endl;
        }
    } while (choice != 5);
    return 0;
}
